{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "C:/Users/<你的用户名>/.ohos/config/default_<项目名>_<随机串>.cer",
          "keyAlias": "debugKey",
          "keyPassword": "<让 DevEco 生成，或者填你自己的>",
          "profile": "C:/Users/<你的用户名>/.ohos/config/default_<项目名>_<随机串>.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "C:/Users/<你的用户名>/.ohos/config/default_<项目名>_<随机串>.p12",
          "storePassword": "<让 DevEco 生成，或者填你自己的>"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "26.0.0",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
